# Kopieer naar .env.local en vul in. Commit nooit echte sleutels.

# Supabase API-URL en publieke (anon/publishable) sleutel. Lokaal: zie `npx supabase status`
# of de uitvoer van `npm run stack:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Geheime service-sleutel. Alleen server-side gebruikt voor: uitnodigen van gebruikers,
# jobs/scheduler, offerte-integratie en scripts. Nooit met NEXT_PUBLIC_ prefix!
SUPABASE_SECRET_KEY=
# (De namen van de Vercel–Supabase-koppeling, NEXT_PUBLIC_SUPABASE_ANON_KEY en SUPABASE_SERVICE_ROLE_KEY, werken ook.)

# Publieke basis-URL van de app (voor uitnodigings- en wachtwoordlinks).
APP_URL=http://localhost:3000

# Beveiligt /api/cron/run (Authorization: Bearer <CRON_SECRET>). Minimaal 32 tekens.
CRON_SECRET=

# Offerte-webhook staat standaard UIT. Alleen aanzetten met een sterk gedeeld geheim.
QUOTE_WEBHOOK_ENABLED=false
QUOTE_WEBHOOK_SECRET=

# Alleen voor de ontwikkelseed (wordt geweigerd tegen een niet-lokale Supabase-URL).
SEED_PASSWORD=
